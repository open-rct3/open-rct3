{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/cslint-if-cs.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/deno-fmt-check-if-dts.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/question-violation.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/question-violation.sh"
          }
        ]
      }
    ]
  }
}
